{
    "manifest_version": 3,
    "name": "Mi Nueva Pestaña",
    "version": "1.0.0",
    "description": "Página de nueva pestaña personalizada con accesos rápidos.",
    
    "permissions": [
        "storage",
        "search"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "chrome_url_overrides": {
        "newtab": "newtab.html"
    }
}