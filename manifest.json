{
    "manifest_version": 3,
    "name": "Mi Nueva Pestaña",
    "version": "1.0.0",
    "description": "Página de nueva pestaña personalizada con accesos rápidos.",
    "permissions": [
        "storage",
        "search",
        "bookmarks",
        "tabs",
        "favicon"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "icons": {
        "16": "Icons/icon1.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    }
}